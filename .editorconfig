root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 140
# Allow wildcard imports: Ktor DSL and similar APIs use many small
# extensions that read more naturally as `io.ktor.foo.*` than as a
# dozen individual lines.
ktlint_standard_no-wildcard-imports = disabled

[*.py]
indent_size = 4

[*.{yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
